{
  "name": "puzzlekingdom",
  "private": true,
  "version": "0.1.0",
  "description": "Puzzle Kingdom - upload course content, get an AI-generated multiple-choice quiz, see your results.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}

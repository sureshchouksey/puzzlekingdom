# Server
PORT=3001

# Which AI provider generates quiz questions from uploaded content: "claude" or "gemini"
AI_PROVIDER=claude

# Anthropic API - required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Google Gemini API - required when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Separate, genuinely-free-tier model used ONLY by the AI Study Mentor
# tutor (never the paid GEMINI_MODEL above) - see env.ts for why.
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite

# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> Transaction pooler)
DATABASE_URL=

# Supabase project - used for file storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-content

# Shared family passcode for the public deployment - every API request
# must send a matching "x-app-passcode" header once this is set. Leave
# unset for local/LAN dev (no gate at all, same as before this existed).
APP_PASSCODE=

# Signs profile/admin session JWTs - any long random string, keep it secret
JWT_SECRET=

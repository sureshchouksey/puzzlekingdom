{
  "name": "@puzzlekingdom/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "start:prod": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed:questions": "tsx --env-file=.env scripts/seed-questions.ts",
    "test:e2e": "tsx --env-file=.env scripts/test-e2e.ts",
    "test:estimate": "tsx --env-file=.env scripts/test-estimate.ts",
    "test:quiz": "tsx --env-file=.env scripts/test-quiz-flow.ts",
    "test:manual": "tsx --env-file=.env scripts/test-manual-seed.ts",
    "backfill:class-topics": "tsx --env-file=.env scripts/backfill-class-topics.ts",
    "backfill:tips": "tsx --env-file=.env scripts/backfill-tips.ts",
    "validate:tips": "tsx scripts/validate-tips.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@google/genai": "^2.21.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
